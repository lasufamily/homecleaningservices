---
type Props = {
  name: string;
  class?: string;
  size?: "card" | "hero";
};

const { class: className = "", size = "card" } = Astro.props;
---

<div
  class:list={[
    "relative overflow-hidden border border-border bg-white",
    size === "hero" ? "aspect-[5/4]" : "aspect-[4/3]",
    className
  ]}
>
  <img
    src="/images/Home-Cleaning-Services-Singapore-Company-Thumbnail.png"
    alt="Home Cleaning Services Singapore Company"
    class="h-full w-full object-cover"
    loading={size === "hero" ? "eager" : "lazy"}
    decoding="async"
  />
</div>
