---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-white">
  <div class="container grid gap-10 py-12 md:grid-cols-[1.2fr_0.8fr_0.8fr_0.8fr]">
    <div>
      <a href="/" class="focus-ring inline-flex" aria-label="Home Cleaning Services home">
        <img
          src="/Home-Cleaning-Services-Singapore-Logo.png"
          alt="Home Cleaning Services Singapore"
          class="h-16 w-auto object-contain md:h-20"
        />
      </a>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-ink">Services</h2>
      <nav class="mt-4 grid gap-3 text-sm text-ink/62" aria-label="Footer services">
        <a class="hover:text-clay" href="/residential/spring-cleaning">Spring Cleaning</a>
        <a class="hover:text-clay" href="/residential/end-of-tenancy-cleaning">End of Tenancy Cleaning</a>
        <a class="hover:text-clay" href="/commercial/office-cleaning">Office Cleaning</a>
        <a class="hover:text-clay" href="/commercial/commercial-building-cleaning">Commercial Building Cleaning</a>
      </nav>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-ink">Company</h2>
      <nav class="mt-4 grid gap-3 text-sm text-ink/62" aria-label="Footer company">
        <a class="hover:text-clay" href="/residential">Residential services</a>
        <a class="hover:text-clay" href="/commercial">Commercial services</a>
        <a class="hover:text-clay" href="/nearme">Near Me</a>
        <a class="hover:text-clay" href="/about">About</a>
        <a class="hover:text-clay" href="/contact">Contact</a>
        <a class="hover:text-clay" href="/companies">Directory</a>
        <a class="hover:text-clay" href="/search">Search</a>
      </nav>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-ink">Legal</h2>
      <nav class="mt-4 grid gap-3 text-sm text-ink/62" aria-label="Footer legal">
        <a class="hover:text-clay" href="/privacy">Privacy policy</a>
        <a class="hover:text-clay" href="/terms">Terms and conditions</a>
      </nav>
      <div class="mt-8 text-sm text-ink/60">
        <p>&copy; {year} Home Cleaning Services.</p>
        <p>Directory listings remain available for comparison.</p>
      </div>
    </div>
  </div>
</footer>
