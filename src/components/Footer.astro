---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-white">
  <div class="container grid gap-8 py-12 md:grid-cols-[1.4fr_1fr] md:items-end">
    <div>
      <p class="eyebrow">Singapore directory</p>
      <p class="serif mt-3 max-w-2xl text-3xl font-semibold leading-tight text-ink">
        A curated guide to home cleaning services, organized by neighbourhood and service type.
      </p>
    </div>
    <div class="text-sm text-ink/60 md:text-right">
      <p>&copy; {year} Home Cleaning Services Directory.</p>
      <p>Built for Cloudflare Pages with Airtable and Pagefind.</p>
    </div>
  </div>
</footer>
