---
import { Clock, Map, MapPin, Phone } from "@lucide/astro";
import type { Business } from "../lib/airtable";
import { getServiceByName } from "../lib/services";
import SocialLinks from "./SocialLinks.astro";

type Props = {
  business: Business;
};

const { business } = Astro.props;
const serviceList = business.categories.length ? business.categories : ["Home cleaning"];
const servicesDescription = serviceList.join(", ");
const serviceTags = serviceList.map((name) => ({
  name,
  linkedService: getServiceByName(name)
}));
---

<section class="container grid gap-10 py-14 lg:grid-cols-[0.75fr_1.25fr]" data-pagefind-body>
  <aside class="border border-border bg-white p-6">
    <div class="grid gap-5 text-sm text-ink/72">
      {business.displayAddress && (
        <p class="flex gap-3">
          <MapPin size={18} class="mt-1 shrink-0 text-clay" aria-hidden="true" />
          <span>{business.displayAddress}</span>
        </p>
      )}
      {business.openingHours && (
        <p class="flex gap-3">
          <Clock size={18} class="mt-1 shrink-0 text-clay" aria-hidden="true" />
          <span>{business.openingHours}</span>
        </p>
      )}
      {business.phone && (
        <p class="flex gap-3">
          <Phone size={18} class="mt-1 shrink-0 text-clay" aria-hidden="true" />
          <a class="focus-ring hover:text-clay" href={`tel:${business.phone.replace(/\s/g, "")}`}>{business.phone}</a>
        </p>
      )}
      {business.googleMapsUrl && (
        <p class="flex gap-3">
          <Map size={18} class="mt-1 shrink-0 text-clay" aria-hidden="true" />
          <a class="focus-ring font-semibold text-ink hover:text-clay" href={business.googleMapsUrl} target="_blank" rel="noreferrer">
            View on Google Maps
          </a>
        </p>
      )}
    </div>
    <div class="mt-7">
      <SocialLinks business={business} />
    </div>
  </aside>
  <div>
    <h2 class="serif text-4xl font-semibold leading-tight text-ink">Services available from {business.name}</h2>
    <p class="mt-5 max-w-3xl text-lg text-ink/68">
      {business.name} offers {servicesDescription} in {business.town}.
      Contact the company directly for availability, service scope, and booking details.
    </p>
    <div class="mt-7 flex flex-wrap gap-3 text-sm font-semibold text-moss">
      {serviceTags.map((service) =>
        service.linkedService ? (
          <a
            class="focus-ring border border-border bg-white px-4 py-3 transition hover:border-clay hover:text-clay"
            href={`/${service.linkedService.group}/${service.linkedService.slug}`}
          >
            {service.name}
          </a>
        ) : (
          <span class="border border-border bg-white px-4 py-3">{service.name}</span>
        )
      )}
    </div>
  </div>
</section>
