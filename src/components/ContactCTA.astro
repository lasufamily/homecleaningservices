---
type Props = {
  eyebrow?: string;
  title?: string;
  body?: string;
};

const {
  eyebrow = "Request a quote",
  title = "Tell us what your home needs cleaned.",
  body = "Share your service, property type, preferred timing, and any special notes. We will use those details to prepare the right cleaning scope."
} = Astro.props;
---

<section class="bg-clay py-14 text-white">
  <div class="container grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-white/72">{eyebrow}</p>
      <h2 class="serif mt-3 max-w-3xl text-4xl font-semibold leading-tight md:text-5xl">{title}</h2>
      <p class="mt-5 max-w-2xl text-white/78">{body}</p>
    </div>
    <a
      href="/contact"
      class="focus-ring inline-flex justify-center bg-white px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-clay transition hover:bg-ink hover:text-white"
    >
      Get a quote
    </a>
  </div>
</section>
