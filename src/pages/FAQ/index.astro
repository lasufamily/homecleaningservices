---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Layout from "../../layouts/Layout.astro";
import { faqItems } from "../../lib/faq";
import { getBreadcrumbJsonLd } from "../../lib/guides";

const origin = (Astro.site ?? Astro.url.origin).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    getBreadcrumbJsonLd(
      [
        { label: "Home", href: "/" },
        { label: "FAQ", href: "/FAQ/" }
      ],
      origin
    ),
    {
      "@type": "CollectionPage",
      name: "FAQ",
      description: "Frequently asked questions about home cleaning services in Singapore.",
      url: new URL("/FAQ/", origin).toString()
    }
  ]
};
---

<Layout
  title="FAQ"
  description="Frequently asked questions about home cleaning services in Singapore, including quotes, preparation, post-renovation cleaning, and service scope."
  jsonLd={jsonLd}
>
  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "FAQ" }
    ]}
  />

  <section class="bg-white">
    <div class="container py-12 md:py-16">
      <h1 class="serif max-w-4xl text-6xl font-semibold leading-[0.9] text-ink md:text-8xl">FAQ</h1>
    </div>
  </section>

  <section class="container py-14" data-pagefind-body>
    <div class="grid gap-4">
      {faqItems.map((item) => (
        <a class="focus-ring border border-border bg-white p-5 text-lg font-semibold text-ink transition hover:border-clay hover:text-clay" href={`/FAQ/${item.slug}/`}>
          {item.question}
        </a>
      ))}
    </div>
  </section>
</Layout>
