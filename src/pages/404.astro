---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="The requested page could not be found. Browse home cleaning services in Singapore or return to the homepage.">
  <section class="container py-20 text-center md:py-28">
    <h1 class="serif text-5xl font-semibold leading-tight text-ink md:text-7xl">Page not found</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-ink/68">
      The page may have moved or the address may be incorrect. Return home to browse cleaning services in Singapore.
    </p>
    <a
      class="focus-ring mt-9 inline-flex bg-clay px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-ink"
      href="/"
    >
      Return home
    </a>
  </section>
</Layout>
