---
import ContactCTA from "../../components/ContactCTA.astro";
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { commercialServices } from "../../lib/services";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Commercial Cleaning Services in Singapore",
  itemListElement: commercialServices.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: service.name,
    url: new URL(`/commercial/${service.slug}`, Astro.site ?? Astro.url.origin).toString()
  }))
};
---

<Layout
  title="Commercial Cleaning Services in Singapore"
  description="See commercial cleaning services in Singapore, including office cleaning, hotel housekeeping, MCST cleaning, F&B cleaning, retail cleaning, and post-construction cleaning."
  jsonLd={jsonLd}
>
  <section class="bg-white">
    <div class="container py-14 md:py-20">
      <h1 class="serif max-w-4xl text-5xl font-semibold leading-[0.95] text-ink md:text-7xl">
        Commercial Cleaning Services in Singapore
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-ink/68">
        Commercial Cleaning Services in Singapore include offices, retail stores, gyms, F&B premises, commercial kitchens,
        and managed buildings, with scopes matched to your site and operating hours.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="focus-ring bg-clay px-6 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-ink" href="/contact?customer_type=Business">
          Get a quote
        </a>
        <a class="focus-ring border border-border bg-white px-6 py-4 text-sm font-bold uppercase tracking-[0.12em] text-ink transition hover:border-clay hover:text-clay" href="/residential">
          Residential services
        </a>
      </div>
    </div>
  </section>

  <section class="container py-14" data-pagefind-body>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {commercialServices.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="bg-white py-14">
    <div class="container grid gap-10 md:grid-cols-[0.75fr_1.25fr]">
      <div>
        <h2 class="serif text-4xl font-semibold leading-tight text-ink md:text-5xl">Quoted around your site and schedule.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ["Share the site", "Tell us the premises type, floor area, rooms, service, and access timing."],
          ["Confirm the scope", "We review operating hours, condition, priorities, and exclusions before quoting."],
          ["Plan the clean", "The cleaning scope is scheduled around business access and site requirements."]
        ].map(([title, body]) => (
          <div class="border border-border bg-linen p-6">
            <h3 class="font-bold text-ink">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-ink/66">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA title="Request a commercial cleaning quote." />
</Layout>
