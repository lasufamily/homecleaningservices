---
import Layout from "../layouts/Layout.astro";
import QuoteForm from "../components/QuoteForm.astro";

const selectedService = Astro.url.searchParams.get("service") ?? "";
const selectedCustomerType = Astro.url.searchParams.get("customer_type") === "Business" ? "Business" : "Home";
---

<Layout
  title="Contact Home Cleaning Services Singapore"
  description="Request a quote from Home Cleaning Services for home cleaning, deep cleaning, spring cleaning, move in move out cleaning, and specialist cleaning services in Singapore."
>
  <section class="bg-white">
    <div class="container grid gap-10 py-14 md:grid-cols-[0.9fr_1.1fr] md:items-start md:py-20">
      <div>
        <h1 class="serif max-w-3xl text-5xl font-semibold leading-[0.95] text-ink md:text-7xl">
          Contact Us
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-ink/68">
          Use this page to contact Home Cleaning Services Singapore with your home type, preferred service, timing, and any
          areas that need extra attention. Those details help us quote the job properly.
        </p>
      </div>

      <QuoteForm selectedService={selectedService} selectedCustomerType={selectedCustomerType} />
    </div>
  </section>
</Layout>
