---
import Layout from "../layouts/Layout.astro";
import { services } from "../lib/services";

const selectedService = Astro.url.searchParams.get("service") ?? "";
---

<Layout
  title="Contact Home Cleaning Services Singapore"
  description="Request a quote from Home Cleaning Services for home cleaning, deep cleaning, spring cleaning, move in move out cleaning, and specialist cleaning services in Singapore."
>
  <section class="bg-white">
    <div class="container grid gap-10 py-14 md:grid-cols-[0.9fr_1.1fr] md:items-start md:py-20">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="serif mt-5 max-w-3xl text-6xl font-semibold leading-[0.9] text-ink md:text-8xl">
          Request a cleaning quote
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-ink/68">
          Share your home type, preferred service, timing, and any areas that need extra attention. Those details help us
          quote the job properly.
        </p>
      </div>

      <form
        id="quote-form"
        action="https://submit-form.com/TmT9DZNtR"
        method="POST"
        class="border border-border bg-linen p-6 md:p-8"
      >
        <div class="grid gap-5">
          <label class="grid gap-2 text-sm font-semibold text-ink">
            <span>Name <span class="text-red-600" aria-hidden="true">*</span></span>
            <input name="name" required class="focus-ring border border-border bg-white px-4 py-3 font-normal text-ink" autocomplete="name" />
          </label>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-ink">
              <span>Phone <span class="text-red-600" aria-hidden="true">*</span></span>
              <input name="phone" required class="focus-ring border border-border bg-white px-4 py-3 font-normal text-ink" autocomplete="tel" />
            </label>
            <label class="grid gap-2 text-sm font-semibold text-ink">
              <span>Email <span class="text-red-600" aria-hidden="true">*</span></span>
              <input name="email" required type="email" class="focus-ring border border-border bg-white px-4 py-3 font-normal text-ink" autocomplete="email" />
            </label>
          </div>

          <label class="grid gap-2 text-sm font-semibold text-ink">
            <span>Service <span class="text-red-600" aria-hidden="true">*</span></span>
            <select name="service" required class="focus-ring border border-border bg-white px-4 py-3 font-normal text-ink">
              <option value="">Select a service</option>
              {services.map((service) => (
                <option value={service.name} selected={selectedService === service.name}>{service.name}</option>
              ))}
            </select>
          </label>

          <label class="grid gap-2 text-sm font-semibold text-ink">
            <span>Message <span class="text-red-600" aria-hidden="true">*</span></span>
            <textarea
              name="message"
              required
              rows="6"
              class="focus-ring border border-border bg-white px-4 py-3 font-normal text-ink"
              placeholder="Tell us the number of rooms, bathrooms, home condition, and anything we should know before quoting."
            ></textarea>
          </label>

          <button
            type="submit"
            class="focus-ring bg-clay px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-ink"
          >
            Send enquiry
          </button>
          <p id="quote-status" class="hidden border border-border bg-white p-4 text-sm text-ink/70" role="status" aria-live="polite">
            Thanks. Your enquiry has been sent.
          </p>
        </div>
      </form>
    </div>
  </section>

  <script is:inline>
    const form = document.querySelector("#quote-form");
    const status = document.querySelector("#quote-status");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const action = form.action;
      const button = form.querySelector('button[type="submit"]');

      if (button) button.disabled = true;
      if (status) {
        status.textContent = "Sending...";
        status.classList.remove("hidden");
      }

      try {
        const response = await fetch(action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        if (!response.ok) {
          throw new Error("Form submission failed");
        }

        form.reset();
        if (status) status.textContent = "Thanks. Your enquiry has been sent.";
      } catch {
        if (status) status.textContent = "Sorry, the form could not be sent. Please try again.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  </script>
</Layout>
