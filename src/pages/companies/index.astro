---
import Layout from "../../layouts/Layout.astro";
import FilterBar from "../../components/FilterBar.astro";
import ListingCard from "../../components/ListingCard.astro";
import SearchBox from "../../components/SearchBox.astro";
import { getBusinesses, getCategories, getTowns, sortBusinesses } from "../../lib/airtable";

const businesses = sortBusinesses(await getBusinesses(), "name");
const towns = getTowns(businesses);
const categories = getCategories(businesses);
---

<Layout
  title="Cleaning Companies in Singapore"
  description="Browse home cleaning companies in Singapore by town, service category, address, and phone number."
>
  <section class="container py-12">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h1 class="serif text-5xl font-semibold leading-none text-ink md:text-7xl">Cleaning Companies in Singapore</h1>
        <p class="mt-5 max-w-2xl text-lg text-ink/68">
          Cleaning Companies in Singapore can be compared by town, service, address, and contact details.
        </p>
      </div>
      <SearchBox compact={true} />
    </div>
  </section>

  <section class="container">
    <FilterBar towns={towns} categories={categories} />
  </section>

  <section class="container py-10" data-pagefind-body>
    <div class="mb-6 flex items-center justify-between gap-4 text-sm text-ink/60">
      <p><span data-results-count>{businesses.length}</span> <span data-results-label>{businesses.length === 1 ? "company" : "companies"}</span> found</p>
      <a class="focus-ring font-semibold text-clay hover:text-ink" href="/companies" data-clear-filters hidden>Clear filters</a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-companies-grid>
      {businesses.map((business) => (
        <div
          data-company-card
          data-name={business.name}
          data-town={business.town}
          data-categories={business.categories.join("||")}
          data-search={[business.name, business.town, business.categories.join(" "), business.displayAddress, business.phone].filter(Boolean).join(" ")}
        >
          <ListingCard business={business} />
        </div>
      ))}
    </div>
    <div class="border border-border bg-white p-10 text-center" data-empty-state hidden>
      <h2 class="serif text-4xl font-semibold text-ink">No companies found</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink/66">Try another town or service category.</p>
    </div>
  </section>

  <script>
    const form = document.querySelector("[data-company-filter]");
    const grid = document.querySelector("[data-companies-grid]");
    const cards = Array.from(document.querySelectorAll("[data-company-card]"));
    const count = document.querySelector("[data-results-count]");
    const label = document.querySelector("[data-results-label]");
    const clearFilters = document.querySelector("[data-clear-filters]");
    const emptyState = document.querySelector("[data-empty-state]");

    const getField = (name) => form?.querySelector(`[name="${name}"]`);
    const normalize = (value) => value?.toString().trim().toLowerCase() ?? "";

    function getStateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      return {
        town: params.get("town") ?? "",
        category: params.get("category") ?? "",
        search: params.get("search") ?? "",
        sort: params.get("sort") === "name-desc" ? "name-desc" : "name"
      };
    }

    function setFormState(state) {
      const town = getField("town");
      const category = getField("category");
      const search = getField("search");
      const sort = getField("sort");

      if (town) town.value = state.town;
      if (category) category.value = state.category;
      if (search) search.value = state.search;
      if (sort) sort.value = state.sort;
    }

    function getFormState() {
      return {
        town: getField("town")?.value ?? "",
        category: getField("category")?.value ?? "",
        search: getField("search")?.value ?? "",
        sort: getField("sort")?.value === "name-desc" ? "name-desc" : "name"
      };
    }

    function writeUrl(state) {
      const params = new URLSearchParams();
      if (state.town) params.set("town", state.town);
      if (state.category) params.set("category", state.category);
      if (state.search) params.set("search", state.search);
      if (state.sort === "name-desc") params.set("sort", state.sort);

      const query = params.toString();
      history.pushState(state, "", query ? `/companies?${query}` : "/companies");
    }

    function applyFilters(state) {
      const town = normalize(state.town);
      const category = normalize(state.category);
      const search = normalize(state.search);
      const sortedCards = [...cards].sort((a, b) => {
        const result = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
        return state.sort === "name-desc" ? -result : result;
      });
      let visibleCount = 0;

      for (const card of sortedCards) {
        const categories = (card.dataset.categories ?? "").split("||").map(normalize);
        const matchesTown = !town || normalize(card.dataset.town) === town;
        const matchesCategory = !category || categories.includes(category);
        const matchesSearch = !search || normalize(card.dataset.search).includes(search);
        const isVisible = matchesTown && matchesCategory && matchesSearch;

        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
        grid?.append(card);
      }

      if (count) count.textContent = visibleCount.toString();
      if (label) label.textContent = visibleCount === 1 ? "company" : "companies";
      if (emptyState) emptyState.hidden = visibleCount > 0;
      if (clearFilters) clearFilters.hidden = !(state.town || state.category || state.search || state.sort === "name-desc");
    }

    if (form && grid) {
      const initialState = getStateFromUrl();
      setFormState(initialState);
      applyFilters(initialState);

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const state = getFormState();
        writeUrl(state);
        applyFilters(state);
      });

      window.addEventListener("popstate", () => {
        const state = getStateFromUrl();
        setFormState(state);
        applyFilters(state);
      });
    }
  </script>
</Layout>
