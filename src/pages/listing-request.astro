---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<Layout title="Listing Corrections and Removal Requests" description="Contact the Home Cleaning Services directory team to suggest a correction or request removal of a company listing." noindex>
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Companies", href: "/companies/" }, { label: "Listing request" }]} />
  <section class="container max-w-3xl py-12 md:py-16">
    <h1 class="serif text-4xl font-semibold leading-tight text-ink md:text-5xl">Listing corrections and removal requests</h1>
    <p class="mt-5 text-lg leading-8 text-ink/68">Use this form to contact the Home Cleaning Services directory team about a company listing. Requests are reviewed by our team; submitting a request does not automatically change or remove a listing.</p>
    <form id="listing-request-form" action="https://submit-form.com/0xkfgAzfo" method="POST" class="mt-8 grid gap-5 border border-border bg-linen p-6 md:p-8">
      <input type="hidden" name="_email.from" value="Home Cleaning Services" />
      <input type="hidden" name="_email.subject" value="Company listing correction or removal request" />
      <label class="grid gap-2 text-sm font-semibold text-ink">
        <span>Request type</span>
        <select name="request_type" required class="focus-ring w-full min-w-0 border border-border bg-white px-4 py-3 font-normal">
          <option value="correction">Suggest a correction</option>
          <option value="removal">Request listing removal</option>
        </select>
      </label>
      <label class="grid gap-2 text-sm font-semibold text-ink">
        <span>Company name</span>
        <input name="company_name" required maxlength="200" class="focus-ring w-full min-w-0 border border-border bg-white px-4 py-3 font-normal" />
      </label>
      <label class="grid gap-2 text-sm font-semibold text-ink">
        <span>Listing URL</span>
        <input name="listing_url" type="url" required class="focus-ring w-full min-w-0 border border-border bg-white px-4 py-3 font-normal" />
      </label>
      <label class="grid gap-2 text-sm font-semibold text-ink">
        <span>Your name</span>
        <input name="name" required autocomplete="name" class="focus-ring w-full min-w-0 border border-border bg-white px-4 py-3 font-normal" />
      </label>
      <label class="grid gap-2 text-sm font-semibold text-ink">
        <span>Your email</span>
        <input name="email" type="email" required autocomplete="email" class="focus-ring w-full min-w-0 border border-border bg-white px-4 py-3 font-normal" />
      </label>
      <label class="grid gap-2 text-sm font-semibold text-ink">
        <span>Details of the correction or reason for removal</span>
        <textarea name="message" required rows="5" class="focus-ring w-full min-w-0 border border-border bg-white px-4 py-3 font-normal"></textarea>
      </label>
      <button type="submit" class="focus-ring bg-clay px-6 py-3 text-sm font-bold text-white transition hover:bg-ink disabled:cursor-not-allowed disabled:opacity-70">Send listing request</button>
      <p id="listing-request-status" class="hidden border border-border bg-white p-4 text-sm text-ink/72" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<script is:inline>
  const listingForm = document.getElementById("listing-request-form");
  if (listingForm instanceof HTMLFormElement) {
    const params = new URLSearchParams(window.location.search);
    const company = listingForm.elements.namedItem("company_name");
    const listing = listingForm.elements.namedItem("listing_url");
    const type = listingForm.elements.namedItem("request_type");
    company.value = (params.get("company") || "").slice(0, 200);
    const listingPath = params.get("listing") || "";
    if (/^\/companies\/[a-z0-9-]+\/$/.test(listingPath)) {
      listing.value = new URL(listingPath, "https://homecleaningservices.sg").href;
    }
    type.value = params.get("type") === "removal" ? "removal" : "correction";

    listingForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = listingForm.querySelector('button[type="submit"]');
      const status = document.getElementById("listing-request-status");
      const data = Object.fromEntries(new FormData(listingForm));
      delete data["_email.from"];
      delete data["_email.subject"];
      data._email = {
        from: "Home Cleaning Services",
        subject: `Listing ${data.request_type} request — ${data.company_name}`
      };
      button.disabled = true;
      status.classList.remove("hidden");
      status.textContent = "Sending...";
      try {
        const response = await fetch(listingForm.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data)
        });
        if (!response.ok) throw new Error("Submission failed");
        status.textContent = "Thank you. Your listing request has been sent to the directory team for review.";
        listingForm.elements.namedItem("message").value = "";
      } catch {
        status.textContent = "Your request could not be sent. Please try again. Your details have been kept in the form.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
