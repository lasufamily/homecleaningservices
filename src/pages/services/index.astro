---
import ContactCTA from "../../components/ContactCTA.astro";
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { services } from "../../lib/services";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Home Cleaning Services in Singapore",
  itemListElement: services.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: service.name,
    url: new URL(`/services/${service.slug}`, Astro.site ?? Astro.url.origin).toString()
  }))
};
---

<Layout
  title="Cleaning Services Singapore | Home Cleaning Services"
  description="See home cleaning services in Singapore, including home cleaning, part time maid, deep cleaning, spring cleaning, move in move out cleaning, and upholstery care."
  jsonLd={jsonLd}
>
  <section class="bg-white">
    <div class="container py-14 md:py-20">
      <p class="eyebrow">Services</p>
      <h1 class="serif mt-5 max-w-4xl text-6xl font-semibold leading-[0.9] text-ink md:text-8xl">
        Home cleaning services across Singapore
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-ink/68">
        From regular housekeeping to move-out cleaning and fabric care, Home Cleaning Services helps Singapore households
        choose a scope that fits the home, timing, and condition.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="focus-ring bg-clay px-6 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-ink" href="/contact">
          Get a quote
        </a>
        <a class="focus-ring border border-border bg-white px-6 py-4 text-sm font-bold uppercase tracking-[0.12em] text-ink transition hover:border-clay hover:text-clay" href="/companies">
          Compare companies
        </a>
      </div>
    </div>
  </section>

  <section class="container py-14" data-pagefind-body>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="bg-white py-14">
    <div class="container grid gap-10 md:grid-cols-[0.75fr_1.25fr]">
      <div>
        <p class="eyebrow">How quotes work</p>
        <h2 class="serif mt-3 text-4xl font-semibold leading-tight text-ink md:text-5xl">Quoted around your home, not a generic package.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ["Share the job", "Tell us your property type, rooms, service, and preferred date."],
          ["Confirm the scope", "We review condition, access, special requests, and any exclusions before quoting."],
          ["Prepare the clean", "The cleaner arrives with the agreed scope and priorities."]
        ].map(([title, body]) => (
          <div class="border border-border bg-linen p-6">
            <h3 class="font-bold text-ink">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-ink/66">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
