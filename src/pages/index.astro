---
import { BadgeDollarSign, MapPin, ShieldCheck, Users } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import ListingCard from "../components/ListingCard.astro";
import QuoteForm from "../components/QuoteForm.astro";
import SearchBox from "../components/SearchBox.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { getBusinesses, getCategories } from "../lib/airtable";
import { getLocationPath, getLocationTowns } from "../lib/locations";
import { residentialServices } from "../lib/services";

const businesses = await getBusinesses();
const featured = businesses.slice(0, 3);
const towns = getLocationTowns(businesses).slice(0, 8);
const categories = getCategories(businesses).slice(0, 8);
const featuredServices = residentialServices.slice(0, 6);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Home Cleaning Services",
  url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
  areaServed: {
    "@type": "Country",
    name: "Singapore"
  },
  description:
    "Home Cleaning Services arranges home cleaning, deep cleaning, spring cleaning, move in move out cleaning, and specialist fabric cleaning in Singapore.",
  makesOffer: residentialServices.map((service) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: service.name,
      url: new URL(`/residential/${service.slug}`, Astro.site ?? Astro.url.origin).toString()
    }
  }))
};
---

<Layout
  title="Home Cleaning Services Singapore | Free Quote"
  description="Home Cleaning Services arranges home cleaning, part time maid, deep cleaning, spring cleaning, move in move out cleaning, and specialist cleaning services in Singapore."
  jsonLd={jsonLd}
>
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <img
      src="/images/Home-Cleaning-Services-Singapore-Hero-1.png"
      alt="Home Cleaning Services Singapore"
      class="absolute inset-0 -z-20 h-full w-full object-cover opacity-30"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/88 to-ink/48"></div>
    <div class="container grid gap-10 py-14 md:grid-cols-[0.95fr_0.85fr] md:items-center md:py-20">
      <div class="max-w-3xl">
        <h1 class="serif text-5xl font-semibold leading-[0.9] text-white md:text-7xl">
          Home Cleaning Services in Singapore.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-white/76">
          Looking for Home Cleaning Services Singapore? We help you find trusted experts for the cleaning job you need.
        </p>
        <div class="mt-7 grid gap-3 text-sm font-semibold text-white/84 sm:grid-cols-2">
          <span class="border-l-2 border-clay pl-3">Flat Rate (No Hidden Fees)</span>
          <span class="border-l-2 border-clay pl-3">Fast Quote</span>
          <span class="border-l-2 border-clay pl-3">Flexible Scheduling</span>
          <span class="border-l-2 border-clay pl-3">Satisfaction Guaranteed</span>
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="focus-ring border border-white/36 bg-white px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-ink transition hover:border-clay hover:bg-clay hover:text-white" href="/residential">
            View services
          </a>
        </div>
      </div>
      <div>
        <QuoteForm
          formAction="https://submit-form.com/TmT9DZNtR"
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20" data-pagefind-body>
    <div class="container">
      <h2 class="serif max-w-4xl text-4xl font-semibold leading-tight text-ink md:text-5xl">
        Why Choose Home Cleaning Services?
      </h2>
      <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        <article>
          <div class="flex h-16 w-16 items-center justify-center rounded-md border border-clay/15 bg-clay/10 text-clay">
            <BadgeDollarSign size={28} aria-hidden="true" />
          </div>
          <h3 class="mt-6 text-xl font-bold leading-snug text-ink">Affordable Pricing</h3>
          <p class="mt-3 leading-7 text-ink/68">
            We believe professional cleaning should be accessible to everyone, so we offer affordable pricing and transparent
            quotes, with no hidden fees or surprises.
          </p>
        </article>
        <article>
          <div class="flex h-16 w-16 items-center justify-center rounded-md border border-clay/15 bg-clay/10 text-clay">
            <ShieldCheck size={28} aria-hidden="true" />
          </div>
          <h3 class="mt-6 text-xl font-bold leading-snug text-ink">Background Checked &amp; Vetted Cleaners</h3>
          <p class="mt-3 leading-7 text-ink/68">
            All of our cleaners go through rigorous vetting process to make sure your home is in safe hands.
          </p>
        </article>
        <article>
          <div class="flex h-16 w-16 items-center justify-center rounded-md border border-clay/15 bg-clay/10 text-clay">
            <MapPin size={28} aria-hidden="true" />
          </div>
          <h3 class="mt-6 text-xl font-bold leading-snug text-ink">Local Experts</h3>
          <p class="mt-3 leading-7 text-ink/68">
            We understand the cleaning industry in Singapore and care about getting the job right.
          </p>
        </article>
        <article>
          <div class="flex h-16 w-16 items-center justify-center rounded-md border border-clay/15 bg-clay/10 text-clay">
            <Users size={28} aria-hidden="true" />
          </div>
          <h3 class="mt-6 text-xl font-bold leading-snug text-ink">Efficient Cleaning</h3>
          <p class="mt-3 leading-7 text-ink/68">
            Jobs are completed by crews of 2-3 cleaners, allowing us to clean your premises quickly and thoroughly without
            compromising detail.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="container py-14" data-pagefind-body>
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <h2 class="serif text-4xl font-semibold text-ink md:text-5xl">Our Residential Cleaning Services</h2>
      </div>
      <a href="/residential" class="focus-ring text-sm font-bold uppercase tracking-[0.14em] text-clay hover:text-ink">View all services</a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {featuredServices.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="bg-white py-14">
    <div class="container mb-10 grid gap-8 md:grid-cols-[0.85fr_1.15fr]">
      <div>
        <h2 class="serif text-4xl font-semibold text-ink md:text-5xl">Compare cleaning companies near you.</h2>
      </div>
      <div>
        <p class="text-lg leading-8 text-ink/68">
          Browse providers by neighbourhood or cleaning need when you want to compare a few options before asking for a quote.
        </p>
        <div class="mt-6">
          <SearchBox compact={true} />
        </div>
      </div>
    </div>
    <div class="container grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="serif text-4xl font-semibold text-ink">Neighbourhoods</h2>
        <div class="mt-7 flex flex-wrap gap-3">
          {towns.map((town) => (
            <a class="focus-ring border border-border px-4 py-3 text-sm font-semibold text-ink transition hover:border-clay hover:text-clay" href={getLocationPath(town)}>
              {town}
            </a>
          ))}
        </div>
      </div>
      <div>
        <h2 class="serif text-4xl font-semibold text-ink">Cleaning categories</h2>
        <div class="mt-7 flex flex-wrap gap-3">
          {categories.map((category) => (
            <a class="focus-ring border border-border px-4 py-3 text-sm font-semibold text-ink transition hover:border-clay hover:text-clay" href={`/companies?category=${encodeURIComponent(category)}`}>
              {category}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container py-14">
      <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <h2 class="serif text-4xl font-semibold text-ink md:text-5xl">Cleaning companies to compare</h2>
        </div>
        <a href="/companies" class="focus-ring text-sm font-bold uppercase tracking-[0.14em] text-clay hover:text-ink">View companies</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {featured.map((business) => <ListingCard business={business} />)}
      </div>
    </section>
  )}

  <section class="container py-16 text-center">
    <h2 class="serif mx-auto max-w-3xl text-4xl font-semibold leading-tight text-ink md:text-5xl">
      Need a quote for your own home cleaning job?
    </h2>
    <a class="focus-ring mt-8 inline-flex bg-clay px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-white hover:text-clay" href="/contact">
      Contact us
    </a>
  </section>

  <ContactCTA />
</Layout>
