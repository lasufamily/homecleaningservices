---
import Layout from "../layouts/Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import ListingCard from "../components/ListingCard.astro";
import SearchBox from "../components/SearchBox.astro";
import InitialsImage from "../components/InitialsImage.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { getBusinesses, getCategories, getTowns } from "../lib/airtable";
import { services } from "../lib/services";

const businesses = await getBusinesses();
const featured = businesses.slice(0, 3);
const towns = getTowns(businesses).slice(0, 8);
const categories = getCategories(businesses).slice(0, 8);
const featuredServices = services.slice(0, 6);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Home Cleaning Services",
  url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
  areaServed: {
    "@type": "Country",
    name: "Singapore"
  },
  description:
    "Home Cleaning Services arranges home cleaning, deep cleaning, spring cleaning, move in move out cleaning, and specialist fabric cleaning in Singapore.",
  makesOffer: services.map((service) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: service.name,
      url: new URL(`/services/${service.slug}`, Astro.site ?? Astro.url.origin).toString()
    }
  }))
};
---

<Layout
  title="Home Cleaning Services Singapore | Cleaning Company"
  description="Home Cleaning Services arranges home cleaning, part time maid, deep cleaning, spring cleaning, move in move out cleaning, and specialist cleaning services in Singapore."
  jsonLd={jsonLd}
>
  <section class="bg-white">
    <div class="container grid gap-10 py-14 md:grid-cols-[1.08fr_0.92fr] md:items-end md:py-20">
      <div>
        <p class="eyebrow">Singapore home cleaning company</p>
        <h1 class="serif mt-5 max-w-4xl text-6xl font-semibold leading-[0.9] text-ink md:text-8xl">
          Home cleaning services in Singapore
        </h1>
        <p class="mt-7 max-w-2xl text-lg text-ink/68">
          Get a quote for regular housekeeping, part time maid support, deep cleaning, move-in and move-out cleans,
          post-renovation dust, or fabric care.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="focus-ring bg-clay px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-ink" href="/contact">
            Get a quote
          </a>
          <a class="focus-ring border border-border bg-white px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-ink transition hover:border-clay hover:text-clay" href="/services">
            View services
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        {featured[0] && <InitialsImage name={featured[0].name} size="hero" class="aspect-[4/5]" />}
      </div>
    </div>
  </section>

  <section class="container grid gap-10 py-14 md:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow">What we do</p>
      <h2 class="serif mt-3 text-4xl font-semibold leading-tight text-ink md:text-5xl">Cleaning scopes for lived-in Singapore homes.</h2>
    </div>
    <p class="text-lg leading-8 text-ink/68">
      Whether you need weekly upkeep, a one-time clean before guests arrive, a handover clean, or help with mattresses, sofas,
      curtains, carpets, and floors, the quote starts with the home as it is.
    </p>
  </section>

  <section class="container py-14" data-pagefind-body>
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">Popular services</p>
        <h2 class="serif mt-3 text-4xl font-semibold text-ink md:text-5xl">Start with the right clean</h2>
      </div>
      <a href="/services" class="focus-ring text-sm font-bold uppercase tracking-[0.14em] text-clay hover:text-ink">View all services</a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {featuredServices.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="bg-white py-14">
    <div class="container mb-10 grid gap-8 md:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="eyebrow">Directory</p>
        <h2 class="serif mt-3 text-4xl font-semibold text-ink md:text-5xl">Browse other cleaning companies.</h2>
      </div>
      <div>
        <p class="text-lg leading-8 text-ink/68">
          The company directory is still here for homeowners who want to compare providers by town, service, and contact details.
        </p>
        <div class="mt-6">
          <SearchBox compact={true} />
        </div>
      </div>
    </div>
    <div class="container grid gap-12 md:grid-cols-2">
      <div>
        <p class="eyebrow">Browse by town</p>
        <h2 class="serif mt-3 text-4xl font-semibold text-ink">Neighbourhoods</h2>
        <div class="mt-7 flex flex-wrap gap-3">
          {towns.map((town) => (
            <a class="focus-ring border border-border px-4 py-3 text-sm font-semibold text-ink transition hover:border-clay hover:text-clay" href={`/companies?town=${encodeURIComponent(town)}`}>
              {town}
            </a>
          ))}
        </div>
      </div>
      <div>
        <p class="eyebrow">Browse by service</p>
        <h2 class="serif mt-3 text-4xl font-semibold text-ink">Cleaning categories</h2>
        <div class="mt-7 flex flex-wrap gap-3">
          {categories.map((category) => (
            <a class="focus-ring border border-border px-4 py-3 text-sm font-semibold text-ink transition hover:border-clay hover:text-clay" href={`/companies?category=${encodeURIComponent(category)}`}>
              {category}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container py-14">
      <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Directory examples</p>
          <h2 class="serif mt-3 text-4xl font-semibold text-ink md:text-5xl">Selected company listings</h2>
        </div>
        <a href="/companies" class="focus-ring text-sm font-bold uppercase tracking-[0.14em] text-clay hover:text-ink">View directory</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {featured.map((business) => <ListingCard business={business} />)}
      </div>
    </section>
  )}

  <section class="container py-16 text-center">
    <p class="eyebrow">Need a quote?</p>
    <h2 class="serif mx-auto mt-3 max-w-3xl text-4xl font-semibold leading-tight text-ink md:text-5xl">
      Need a quote for your own home cleaning job?
    </h2>
    <a class="focus-ring mt-8 inline-flex bg-clay px-7 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-white hover:text-clay" href="/contact">
      Contact us
    </a>
  </section>

  <ContactCTA />
</Layout>
